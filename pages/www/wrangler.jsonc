{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "645-live",
	"compatibility_date": "2025-05-30",
	"pages_build_output_dir": "./.svelte-kit/cloudflare",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"BETTER_AUTH_URL": "https://645.live",
		"TRAILBASE_URL": "https://trail.645.live",
		"PUBLIC_TRAILBASE_URL": "https://trail.645.live"
	},
	"hyperdrive": [
		{
			"id": "d1baf1d31eb047d58ae2c9f27928fc79",
			"binding": "HYPERDRIVE",
			"localConnectionString": "postgres://root:mysecretpassword@localhost:50101/local"
		}
	],
	"services": [
		{
			"binding": "OG_645_LIVE",
			"service": "og-645-live"
		},
		{
			"binding": "AUTH_HASHER",
			"service": "auth-hasher-645-live"
		}
	]
}
