{
	"name": "www",
	"private": true,
	"type": "module",
	"scripts": {
		"add": "bun add",
		"dev": "vite dev --host 0.0.0.0",
		"dev:bun": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bun run build && wrangler pages dev",
		"deploy": "bun run build && wrangler pages deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tail": "wrangler pages deployment tail --project-name 645live",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:drop": "drizzle-kit drop",
		"db:generate": "drizzle-kit generate --config=drizzle-prod.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle-prod.config.ts",
		"db:studio": "drizzle-kit studio",
		"db:studio:remote": "drizzle-kit studio --config=drizzle-prod.config.ts",
		"cf-typegen": "wrangler types src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^22.19.15",
		"better-auth": "^1.5.5",
		"daisyui": "^5.5.19",
		"drizzle-kit": "^0.31.9",
		"mdsvex": "^0.12.7",
		"svelte": "^5.53.12",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.1",
		"trailbase": "^0.7.4",
		"typescript": "^5.9.3",
		"vite": "catalog:",
		"wrangler": "^4.74.0"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@microsoft/clarity": "^1.0.2",
		"barqode": "^0.0.2",
		"drizzle-orm": "^0.44.7",
		"hono": "^4.12.8",
		"nuqs-svelte": "^1.2.2",
		"postgres": "^3.4.8",
		"super-sitemap": "^1.0.7",
		"svelte-meta-tags": "^4.5.0",
		"svelte-sonner": "^1.1.0"
	}
}
