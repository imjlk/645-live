# bun run toss dev starts a separate local TrailBase and sets the app API automatically.
# Optional: choose localhost for a simulator, or your computer's LAN IP for a phone.
# LOTTO_DEV_HOST=127.0.0.1
# LOTTO_DEV_PORT=4015

# Used by dev:remote / production builds; requires configured Toss verification.
LOTTO_APP_ENV=production
LOTTO_API_BASE_URL=https://trail.645.live
