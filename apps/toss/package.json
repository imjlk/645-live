		"@trailbase-apps-in-toss-kit/trailbase-client": "workspace:*",
		"@toss/tds-react-native": "^2.0.3",
		"brick-module": "0.5.2",
		"fast-text-encoding": "^1.0.6",
		"react": "19.2.3",
		"react-native": "0.85.3",
		"react-native-safe-area-context": "5.6.2",
