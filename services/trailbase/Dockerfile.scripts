FROM oven/bun:1-alpine AS base

WORKDIR /app

RUN apk add --no-cache \
    curl \
    tini

COPY traildepot/import-top-store.ts ./
COPY traildepot/import-draw-results.ts ./
# Mount the existing database at /app/data when running this import image.
# Runtime data must never be baked into a Docker layer.
RUN mkdir -p /app/data

RUN echo '#!/bin/sh' > entrypoint.sh && \
    echo 'set -e' >> entrypoint.sh && \
    echo '[ -s /app/data/main.db ] || { echo "Mount an initialized TrailBase data directory at /app/data" >&2; exit 1; }' >> entrypoint.sh && \
    echo '' >> entrypoint.sh && \
    echo 'echo "🚀 Starting lottery data import scripts..."' >> entrypoint.sh && \
    echo '' >> entrypoint.sh && \
    echo 'echo "📊 Running draw results import..."' >> entrypoint.sh && \
    echo 'bun run import-draw-results.ts latest' >> entrypoint.sh && \
    echo '' >> entrypoint.sh && \
    echo 'sleep 5' >> entrypoint.sh && \
    echo '' >> entrypoint.sh && \
    echo 'echo "🏪 Running top store import..."' >> entrypoint.sh && \
    echo 'bun run import-top-store.ts latest' >> entrypoint.sh && \
    echo '' >> entrypoint.sh && \
    echo 'echo "✅ All scripts completed successfully!"' >> entrypoint.sh && \
    chmod +x entrypoint.sh

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./entrypoint.sh"]
