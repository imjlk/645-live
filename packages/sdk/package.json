{
	"name": "@645live/sdk",
	"version": "0.1.0",
	"description": "JavaScript and TypeScript SDK for the 645.live public API",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
