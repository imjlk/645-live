{
	"name": "@645live/trailbase-adapter",
	"version": "0.1.0",
	"description": "Reusable TrailBase client adapter with Svelte 5 support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"import": "./dist/svelte/index.js"
		},
		"./adapters": {
			"types": "./dist/adapters/index.d.ts",
			"import": "./dist/adapters/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf dist",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"test:ui": "vitest --ui"
	},
	"keywords": [
		"trailbase",
		"realtime",
		"svelte",
		"adapter",
		"websocket"
	],
	"author": "645.live",
	"license": "MIT",
	"peerDependencies": {
		"svelte": "^5.0.0",
		"trailbase": "^0.7.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^2.0.0",
		"@vitest/ui": "^2.0.0",
		"happy-dom": "^15.0.0",
		"typescript": "^5.8.0",
		"vitest": "^2.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/your-org/645.live.git",
		"directory": "packages/trailbase-adapter"
	}
}