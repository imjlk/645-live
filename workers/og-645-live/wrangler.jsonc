{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "og-645-live",
	"main": "src/index.tsx",
	"compatibility_date": "2026-09-12",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"CACHE_ENABLED": "true",
		"CACHE_MAX_AGE": "10800",
		"CACHE_KEY_PREFIX": "og-balls-v1"
	},
	"rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
	// "r2_buckets": [
	// 	{
	// 		"binding": "OG_645_LIVE_R2",
	// 		"bucket_name": "og-645-live-R2"
	// 	}
	// ],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true
		}
	}
}
