{
	"name": "645-live-monorepo",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"www": "bun --cwd pages/www --",
		"og": "bun --cwd workers/og-645-live --",
		"format": "biome check --write .",
		"lint": "biome lint .",
		"clean": "find . \\( -name 'node_modules' -o -name '.svelte-kit' \\) -type d -exec rm -rf {} + && rm -rf bun.lockb",
		"trail": "docker run --pull=always --network host --mount type=bind,source=$PWD/services/trailbase/traildepot,target=/app/traildepot trailbase/trailbase:latest /app/trail",
		"news:generate": "node scripts/news/generate-news-content.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"workspaces": {
		"packages": ["pages/*", "workers/*", "packages/*"],
		"catalog": {
			"vite": "^6.4.1",
			"wrangler": "^4.74.0",
			"hono": "^4.12.8"
		}
	}
}
